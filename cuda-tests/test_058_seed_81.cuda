  unsigned mask = ((1u << width) - 1u) << base;
  unsigned blockMask = (blockDim.x >= 32) ? 0xffffffffu : ((1u << blockDim.x) - 1u);
  return mask & blockMask;
}
static __device__ __forceinline__ int simt_wave_count_bits(bool pred) {
