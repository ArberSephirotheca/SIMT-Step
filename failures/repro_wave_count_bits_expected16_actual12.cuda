# Reduced repro for:
#   cuda-tests_post_switch_help/test_099_seed_99.cuda
#
# Expected (runner / collective-cf): wave_count_bits(true) sees 16 participants
# (odd lanes only).
# Actual (CUDA / __activemask): the 12-lane fast cohort runs ahead and sees 12.
#
# Probe: lane 1 stores the value into scratch[272] at (outer=1, inner=0).

BUFFER scratch TYPE i32 SIZE 273
BUFFER exp_scratch TYPE i32 SIZE 273

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 272 16

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // 16 participants: odd lanes only.
  if ((tid & 1) == 0)
    return;

  // 12 fast lanes (1..23 odd) reach the probe earlier than lanes 25..31 odd.
  int iters = (tid < 24) ? 2 : 4;
  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
      if (outer == 1 && inner == 0) {
        int c = wave_count_bits_true();
        if (tid == 1)
          scratch[272] = c;
      }
    }
  }
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
