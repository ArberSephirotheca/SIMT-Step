# Reduced repro for:
#   cuda-tests_post_switch_help/test_012_seed_12.cuda
#
# This keeps the "post-switch helper call site" pattern:
#   switch (...) { ... }
#   helper0(...);   // call happens after the switch
#
# Mismatch mechanism:
# - 29 lanes (warp1 lanes 3..31) eventually execute the wave op.
# - Under maximal reconvergence / collective-cf expectation, wave_count_bits(true)
#   sees all 29 lanes.
# - On CUDA (with __activemask()), the fast cohort runs ahead and reaches the wave
#   op while the slow cohort is still in earlier iterations, so the wave op sees
#   only 22 lanes (global_tid 35..56).
#
# Probe: lane 3 (global_tid==35) records the value into scratch[291].

BUFFER scratch TYPE i32 SIZE 292
BUFFER exp_scratch TYPE i32 SIZE 292

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 291 29

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

static __device__ __forceinline__ void helper0(int global_tid, int *scratch) {
  // Fast cohort: global_tid 35..56 (22 lanes) => short loop.
  // Slow cohort: global_tid 57..63 (7 lanes) => long loop.
  int iters = (global_tid < 57) ? 2 : 32;
  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
      if (outer == 1 && inner == 0) {
        int c = wave_count_bits_true();
        if (global_tid == 35)
          scratch[291] = c;
      }
    }
  }
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x); // 0..31
  int global_tid = tid + 32;                             // 32..63 (warp1 model)

  // Only warp1 lanes 3..31 participate (global_tid 35..63).
  if (tid < 3)
    return;

  // Post-switch call-site wrapper (call happens after the switch).
  int selector = global_tid % 3;
  int tmp = 0;
  switch (selector) {
  case 0:
    tmp += 1;
    break;
  case 1:
    tmp += 4;
    break;
  default:
    tmp += 2;
    break;
  }

  helper0(global_tid, scratch);
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
