# Reduced repro for:
#   cuda-tests_new_func_non_uniform/test_048_seed_57.cuda
#   cuda-tests_post_switch_help/test_057_seed_57.cuda
#
# Expected (runner / collective-cf): wave_count_bits(true) sees 20 participants.
# Actual (CUDA / __activemask): the 15-lane fast cohort runs ahead and sees 15.
#
# Probe: lane 0 stores the value into scratch[0] at (outer=1, inner=0).

BUFFER scratch TYPE i32 SIZE 1
BUFFER exp_scratch TYPE i32 SIZE 1

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 0 20

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // 20 participants: lanes 20..31 do not execute the wave op.
  if (tid >= 20)
    return;

  // 15 fast lanes (0..14) reach the probe earlier than the others (15..19).
  int iters = (tid < 15) ? 2 : 4;
  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
      if (outer == 1 && inner == 0) {
        int c = wave_count_bits_true();
        if (tid == 0)
          scratch[0] = c;
      }
    }
  }
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
