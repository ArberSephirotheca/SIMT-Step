# Reduced repro for:
#   cuda-tests_new_func_non_uniform/test_011_seed_12.cuda
#   cuda-tests_post_switch_help/test_012_seed_12.cuda
#
# Expected (runner / collective-cf): wave_count_bits(true) sees 29 participants.
# Actual (CUDA / __activemask): the 22-lane fast cohort runs ahead and sees 22.
#
# Probe: lane 3 stores the value into scratch[291] at (outer=1, inner=0).

BUFFER scratch TYPE i32 SIZE 292
BUFFER exp_scratch TYPE i32 SIZE 292

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 291 29

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // 29 participants: lanes 0..2 do not execute the wave op.
  if (tid < 3)
    return;

  // 22 fast lanes (3..24) reach the probe earlier than the others (25..31).
  int iters = (tid < 25) ? 2 : 4;
  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
      if (outer == 1 && inner == 0) {
        int c = wave_count_bits_true();
        if (tid == 3)
          scratch[291] = c;
      }
    }
  }
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
