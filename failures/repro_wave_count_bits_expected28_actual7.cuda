# Reduced repro for:
#   cuda-tests_post_switch_help/test_061_seed_61.cuda
#
# Expected (runner / collective-cf): wave_count_bits(true) sees 28 participants.
# Actual (CUDA / __activemask): the 7-lane fast cohort runs ahead and sees 7.
#
# Probe: lane 0 stores the value into scratch[260] at (outer=1, inner=0).

BUFFER scratch TYPE i32 SIZE 261
BUFFER exp_scratch TYPE i32 SIZE 261

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 260 28

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // 28 participants: lanes 28..31 do not execute the wave op.
  if (tid >= 28)
    return;

  // 7 fast lanes (0..6) reach the probe earlier than lanes 7..27.
  int iters = (tid < 7) ? 2 : 4;
  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
      if (outer == 1 && inner == 0) {
        int c = wave_count_bits_true();
        if (tid == 0)
          scratch[260] = c;
      }
    }
  }
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
