# Reduced repro for switch-related timing divergence affecting wave ops.
#
# This keeps an explicit divergent switch with a "very long" case body, but the
# wave op itself is executed only once, after the switch.
#
# Intended semantics ("collective reconvergence after switch"):
#   wave_count_bits(true) sees all 31 participating lanes in warp1.
#
# Actual CUDA semantics (using __activemask()):
#   fast lanes run ahead, so when the slow cohort reaches the wave op, only that
#   cohort is active at the instruction => smaller participant set.
#
# Setup:
#   - 64 threads, but only warp1 lanes 1..31 participate (global tid 33..63).
#   - switch(tid & 3) makes 8 lanes slow (case 1: tid 33,37,...,61) via a long loop.
#   - Probe stores lane tid==33's wave_count_bits(true) into scratch[33].
#
# Expected: 31
# Actual:   8

BUFFER scratch TYPE i32 SIZE 64
BUFFER exp_scratch TYPE i32 SIZE 64

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 33 31

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // Only warp1 participates; lane0 of warp1 does not participate.
  if (tid < 32)
    return;
  if (tid == 32)
    return;

  // Divergent switch: one case does a lot more work.
  int tmp = tid;
  for (int i = 0; i < tid; ++i){
  switch (tid & 3) {
  case 1: {
    volatile int acc = tmp;
    for (int i = 0; i < 1000000; ++i)
      acc = acc + (i ^ tid);
    tmp = (int)acc;
    
  }
  default:
    tmp = tmp + 1;
    break;
  }
    if (tmp == 0x12345678)
    scratch[0] = tmp;
  }

  // Use tmp so the long loop can't be trivially DCE'd.

  int c = wave_count_bits_true();
  if (tid == 33)
    scratch[33] = c;
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 64 1 1

EXPECT_BUFFER scratch exp_scratch

