# Reduced repro for:
#   cuda-tests_new_func_non_uniform/test_000_seed_44.cuda
#   cuda-tests_new_func_non_uniform/test_036_seed_44.cuda
#   cuda-tests_post_switch_help/test_044_seed_44.cuda
#
# Expected (runner / collective-cf): wave_count_bits(true) sees 31 participants.
# Actual (CUDA / __activemask): fast cohort runs ahead and sees only 8 lanes.
#
# Probe: lane 1 stores the value into scratch[33] at (outer=1, inner=0).

BUFFER scratch TYPE i32 SIZE 64
BUFFER exp_scratch TYPE i32 SIZE 64

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 33 31

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // 31 participants: lane 0 does not execute the wave op.
  if (tid == 0)
    return;

  // 8 fast lanes (1,5,9,...,29) reach the probe earlier than the others.
  int iters = ((tid & 3) == 1) ? 2 : 4;
  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
      if (outer == 1 && inner == 0) {
        int c = wave_count_bits_true();
        if (tid == 1)
          scratch[33] = c;
      }
    }
  }
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
