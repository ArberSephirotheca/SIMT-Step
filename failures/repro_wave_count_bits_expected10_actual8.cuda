# Reduced repro for:
#   cuda-tests_post_switch_help/test_017_seed_17.cuda
#
# Expected (runner / collective-cf): wave_count_bits(true) sees 10 participants.
# Actual (CUDA / __activemask): the 8-lane fast cohort runs ahead and sees 8.
#
# Probe: lane 0 stores the value into scratch[54] at (outer=1, inner=0).

BUFFER scratch TYPE i32 SIZE 55
BUFFER exp_scratch TYPE i32 SIZE 55

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 54 10

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // 10 participants: lanes 10..31 do not execute the wave op.
  if (tid >= 10)
    return;

  // 8 fast lanes (0..7) reach the probe earlier than lanes 8..9.
  int iters = (tid < 8) ? 2 : 4;
  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
      if (outer == 1 && inner == 0) {
        int c = wave_count_bits_true();
        if (tid == 0)
          scratch[54] = c;
      }
    }
  }
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
