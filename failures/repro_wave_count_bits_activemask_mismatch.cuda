# Reduced repro for:
#   cuda-tests_new_func_non_uniform/test_003_seed_3.cuda
#   cuda-tests_new_func_non_uniform/test_011_seed_13.cuda
#   cuda-tests_new_func_non_uniform/test_012_seed_13.cuda
#   cuda-tests_new_func_non_uniform/test_051_seed_60.cuda
#   cuda-tests_post_switch_help/test_003_seed_3.cuda
#   cuda-tests_post_switch_help/test_013_seed_13.cuda
#   cuda-tests_post_switch_help/test_060_seed_60.cuda
#   cuda-tests_post_switch_help/test_071_seed_71.cuda
#   cuda-tests_post_switch_help/test_084_seed_84.cuda
#   cuda-tests_post_switch_help/test_093_seed_93.cuda
#
# Expected (runner / collective-cf): wave_count_bits(true) sees 16 participants
# (odd lanes only).
# Actual (CUDA / __activemask): the fast odd lanes run ahead and see only 8 lanes.
#
# This script records wave_count_bits(true) into scratch for several loop points.
# The first mismatch typically shows up immediately at (outer=0, inner=0),
# i.e. scratch[tid] (e.g. scratch[1] expected=16 actual=8).

BUFFER scratch TYPE i32 SIZE 160
BUFFER exp_scratch TYPE i32 SIZE 160

FILL scratch 0
FILL exp_scratch 0

INIT exp_scratch 129 16
INIT exp_scratch 1 16
INIT exp_scratch 131 16
INIT exp_scratch 3 16
INIT exp_scratch 133 16
INIT exp_scratch 5 16
INIT exp_scratch 135 16
INIT exp_scratch 7 16
INIT exp_scratch 137 16
INIT exp_scratch 9 16
INIT exp_scratch 139 16
INIT exp_scratch 11 16
INIT exp_scratch 141 16
INIT exp_scratch 13 16
INIT exp_scratch 143 16
INIT exp_scratch 15 16
INIT exp_scratch 145 16
INIT exp_scratch 17 16
INIT exp_scratch 147 16
INIT exp_scratch 19 16
INIT exp_scratch 149 16
INIT exp_scratch 21 16
INIT exp_scratch 151 16
INIT exp_scratch 23 16
INIT exp_scratch 153 16
INIT exp_scratch 25 16
INIT exp_scratch 155 16
INIT exp_scratch 27 16
INIT exp_scratch 157 16
INIT exp_scratch 29 16
INIT exp_scratch 159 16
INIT exp_scratch 31 16
INIT exp_scratch 33 16
INIT exp_scratch 35 16
INIT exp_scratch 37 16
INIT exp_scratch 39 16
INIT exp_scratch 41 16
INIT exp_scratch 43 16
INIT exp_scratch 45 16
INIT exp_scratch 47 16
INIT exp_scratch 49 16
INIT exp_scratch 51 16
INIT exp_scratch 53 16
INIT exp_scratch 55 16
INIT exp_scratch 57 16
INIT exp_scratch 59 16
INIT exp_scratch 61 16
INIT exp_scratch 63 16
INIT exp_scratch 67 8
INIT exp_scratch 71 8
INIT exp_scratch 75 8
INIT exp_scratch 79 8
INIT exp_scratch 83 8
INIT exp_scratch 87 8
INIT exp_scratch 91 8
INIT exp_scratch 95 8
INIT exp_scratch 99 8
INIT exp_scratch 103 8
INIT exp_scratch 107 8
INIT exp_scratch 111 8
INIT exp_scratch 115 8
INIT exp_scratch 119 8
INIT exp_scratch 123 8
INIT exp_scratch 127 8

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  return __popc(__ballot_sync(__activemask(), true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = blockIdx.x * blockDim.x + threadIdx.x;

  if ((tid & 1) == 0)
    return;

  int iters = tid & 2 ? 4 : 2;

  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
        scratch[(outer * 4 + inner) * 32 + tid] = wave_count_bits_true();
    }
  }
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
