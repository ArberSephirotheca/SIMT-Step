# Reduced repro for:
#   cuda-tests_post_switch_help/test_019_seed_19.cuda
#
# Expected (runner / collective-cf): wave_count_bits(true) sees 14 participants.
# Actual (CUDA / __activemask): the 10-lane fast cohort runs ahead and sees 10.
#
# Probe: lane 0 stores the value into scratch[18] at (outer=1, inner=0).

BUFFER scratch TYPE i32 SIZE 19
BUFFER exp_scratch TYPE i32 SIZE 19

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 18 14

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // 14 participants: lanes 14..31 do not execute the wave op.
  if (tid >= 14)
    return;

  // 10 fast lanes (0..9) reach the probe earlier than lanes 10..13.
  int iters = (tid < 10) ? 2 : 4;
  for (int outer = 0; outer < iters; ++outer) {
    for (int inner = 0; inner < iters; ++inner) {
      if (outer == 1 && inner == 0) {
        int c = wave_count_bits_true();
        if (tid == 0)
          scratch[18] = c;
      }
    }
  }
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 32 1 1

EXPECT_BUFFER scratch exp_scratch
