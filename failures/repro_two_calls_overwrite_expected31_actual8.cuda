# Reduced repro for:
#   cuda-tests_post_switch_help/test_044_seed_44.cuda
#
# Key pattern in the original:
#   - Kernel has a uniform loop that calls helper0 twice.
#   - helper0 has a non-uniform loop bound (lane-dependent trip count).
#   - wave_count_bits(true) is implemented with __activemask().
#   - The second helper call overwrites the first call's stored result because
#     fast lanes reach call #2 earlier, and slow lanes reach call #2 later.
#
# Expected (runner / "logical mask"): 31 lanes participate at the wave op.
# Actual (CUDA / __activemask): only the slow cohort (8 lanes) is active at the
# wave op when the second call overwrites the probe.
#
# Probe: scratch[33] (lane tid==33 in warp1).

BUFFER scratch TYPE i32 SIZE 64
BUFFER exp_scratch TYPE i32 SIZE 64

FILL scratch 0
FILL exp_scratch 0
INIT exp_scratch 33 31

KERNEL simt_kernel
#include <cuda_runtime.h>

static __device__ __forceinline__ int wave_count_bits_true() {
  unsigned mask = __activemask();
  return __popc(__ballot_sync(mask, true));
}

static __device__ __forceinline__ void helper(int tid, int *scratch, int iters) {
  for (int i = 0; i < iters; ++i) {
    int c = wave_count_bits_true();
    if (i == 0 && tid == 33)
      scratch[33] = c;
  }
}

extern "C" __global__ void simt_kernel(int *scratch) {
  int tid = (int)(blockIdx.x * blockDim.x + threadIdx.x);

  // Only warp1 participates; lane0 of warp1 does not participate.
  if (tid < 32)
    return;
  if (tid == 32)
    return;

  // A divergent switch creates a slow cohort (8 lanes: 33,37,41,...,61).
  // Those lanes take much longer in helper call #1, so when the slow cohort
  // finally reaches call #2, the other lanes have already finished it.
  int tmp = tid;
   int iters = 1;
  switch (tid & 3) {
  case 1: {
    iters = 4;
    break;
  }
  default:
    tmp = tmp + 1;
    iters = 2;
    break;
  }

  // Use tmp so the long loop can't be trivially DCE'd.
  if (tmp == 0x12345678)
    scratch[0] = tmp;


  // Uniform trip count, but non-uniform helper time => call #2 is reached under
  // a smaller active mask for the slow cohort. This overwrites scratch[33].
  for (int call = 0; call < 2; ++call)
    helper(tid, scratch, iters);
    
}
ENDKERNEL

BIND scratch ARG 0

LAUNCH GRID 1 1 1 BLOCK 64 1 1

EXPECT_BUFFER scratch exp_scratch
