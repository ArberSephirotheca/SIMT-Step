    "simt_step.buffer.store"(%arg0, %14, %15) : (!simt_step.resource<Global, i32>, i32, i32) -> ()
    %16 = simt_step.subgroup_id
    %17 = arith.index_cast %16 : index to i32
    return
  }
}

